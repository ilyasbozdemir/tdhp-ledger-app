{
  "name": "tdhp-ledger-app",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-all.js",
    "dev:all": "node scripts/dev-all.js",
    "api:init": "node scripts/init-api.js",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "dev:backend": "cd apps/backend && mix phx.server",
    "test:backend": "cd apps/backend && mix test",
    "dev:desktop": "pnpm --filter desktop start",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:setup": "docker compose up -d && cd apps/backend && mix ecto.setup",
    "pulumi:up": "cd infra && pulumi up --yes",
    "pulumi:down": "cd infra && pulumi destroy --yes"
  }
}
